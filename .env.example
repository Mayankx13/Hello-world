# ── AiEZ landing — environment variables ────────────────────────────────────
# Copy to .env.local for development. On Vercel, set these in
# Project → Settings → Environment Variables.

# Canonical site origin (no trailing slash). Used for metadata, canonical URL,
# OG tags, JSON-LD, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://aiez.example.com

# Google Tag Manager container id. GTM is only injected when this is set.
# The Facebook Pixel is configured INSIDE this GTM container (Custom HTML /
# Pixel tag firing on the dataLayer events below) — it is not hardcoded here.
# Events pushed to the dataLayer: view_sprint_details, cta_click, book_sprint.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# n8n webhook that receives booking submissions (server-side only — never
# exposed to the browser). POST /api/book validates the payload (Zod) and
# forwards JSON: { name, email, whatsapp (+91XXXXXXXXXX), niche, frequency,
# submittedAt, source }.
BOOKING_WEBHOOK_URL=https://n8n.example.com/webhook/aiez-booking
