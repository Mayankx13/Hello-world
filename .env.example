# ============================================
# REAL ESTATE DEAL ENGINE - ENVIRONMENT CONFIG
# ============================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/realestate_deals"

# WhatsApp Baileys (Secondary number - for reading groups)
# No config needed - scans QR code on first run

# WhatsApp Business API (Primary number - for sending messages)
WHATSAPP_BUSINESS_PHONE_ID="your_phone_id"
WHATSAPP_BUSINESS_TOKEN="your_access_token"
WHATSAPP_VERIFY_TOKEN="your_verify_token"

# Your primary WhatsApp number (receives notifications)
OWNER_PHONE="+917719784712"

# Match threshold (0-100)
MATCH_THRESHOLD=70

# Dashboard
DASHBOARD_PORT=3000
DASHBOARD_PASSWORD="changeme123"

# City Config
TARGET_CITY="chandigarh-tricity"
TARGET_AREAS="chandigarh,zirakpur,mohali,kharar,new-chandigarh,panchkula,aerocity,it-city,gmada"

# Logging
LOG_LEVEL="info"
