# ── LIQO Sales Assistant — environment reference ────────────────────────────
# This repo has three deployables, each with its own env. Copy the relevant
# lines where noted. Nothing here is required to run the offline demo.

# ── web (PWA) — set in web/.env.local or Cloudflare Pages env ────────────────
# Base URL of the deployed API Worker. If UNSET, the PWA runs fully offline:
# it executes the same pure engine client-side against the bundled sample.
VITE_API_BASE=https://liqo-api.<your-subdomain>.workers.dev

# ── worker-api — secrets via `wrangler secret put` (NOT committed) ───────────
# ADMIN_TOKEN=<random-long-string>     # gates GET/PUT /config and exports
# ALLOWED_ORIGIN is a [vars] entry in worker-api/wrangler.toml (default "*").

# ── worker-sync — production feed (else the bundled seed is used) ────────────
# INVENTORY_URL=https://feed.internal.liqo.example/inventory.json
# INVENTORY_FORMAT=json                # or "csv"
# ADMIN_TOKEN=<same-or-different>      # gates POST /sync (manual refresh)
# INVENTORY_AUTH=<bearer-for-feed>     # optional
