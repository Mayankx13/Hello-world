# Life OS environment overrides. None required by default.
# The Anthropic key lives in the OS keychain (set via `journal config set-key`),
# not in this file. Use this only for local dev overrides.

# Override the data home (defaults to the repo root).
# LIFE_OS_HOME=/path/to/life-os

# Override the model used by `journal ask` (default: claude-opus-4-7).
# LIFE_OS_MODEL=claude-opus-4-7

# Override the path to the age binary (auto-detected on PATH by default).
# LIFE_OS_AGE_BIN=/usr/local/bin/age

# Override the age identity file (default: ~/.life-os/age.key).
# LIFE_OS_AGE_KEY=/path/to/age.key
