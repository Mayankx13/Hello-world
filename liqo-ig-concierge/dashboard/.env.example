# Build-time configuration (Vite). Copy to .env.local for dev (gitignored).
# In CI/Pages, set these as build environment variables — never commit values.

# Worker API origin. Leave empty when /api/* is routed on the same domain
# (command.amaflip.in). For local dev: http://127.0.0.1:8787
VITE_API_BASE=http://127.0.0.1:8787

# Must equal the Worker's DASH_API_KEY secret. The built bundle sits behind
# Cloudflare Access, so this key is the second lock, not the only one.
VITE_DASH_API_KEY=choose-a-long-random-api-key

# Store-average items-per-bill benchmark shown next to the attributed IPB.
VITE_STORE_AVG_IPB=1.4
