{
  "name": "liqo-sales-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "LIQO Sales Assistant — in-store product recommendation PWA + Cloudflare Workers + a pure, parameterized recommendation engine.",
  "workspaces": [
    "web",
    "worker-api",
    "worker-sync"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:web": "npm --workspace web run dev",
    "build:web": "npm --workspace web run build",
    "deploy:api": "npm --workspace worker-api run deploy",
    "deploy:sync": "npm --workspace worker-sync run deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260617.1",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.3",
    "vitest": "^2.1.9"
  }
}
