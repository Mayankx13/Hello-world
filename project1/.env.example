# ─────────────────────────────────────────────────────────────────────
# Copy this to .env and fill in. .env is gitignored.
#
# Why a .env file and not config in code:
#   1. Secrets never land in git.
#   2. The same code runs locally, in Container Apps, in GitHub Actions —
#      only the env changes.
#   3. The 12-factor app principle (https://12factor.net/config) — every
#      enterprise reviewer is checking for this.
# ─────────────────────────────────────────────────────────────────────

# ── LLM provider ─────────────────────────────────────────────────────
# Why both supported: Azure OpenAI for prod (enterprise data residency,
# private endpoints, the contract every Indian GCC actually has).
# OpenAI direct is fine for local dev — keeps your Azure spend at $0
# until you're ready to deploy.
USE_AZURE_OPENAI=true

# Set these if USE_AZURE_OPENAI=true
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_MINI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Set this if USE_AZURE_OPENAI=false
OPENAI_API_KEY=

# ── Warehouse ────────────────────────────────────────────────────────
# Why DATABASE_URL and not 5 separate vars: SQLAlchemy/psycopg accept
# URLs natively, and every cloud's secret manager handles them as one
# unit. Easier to rotate.
DATABASE_URL=postgresql://retail:retail@localhost:5432/olist

# Read-only DB role used by the NL2SQL executor.
# CRITICAL: this is the role the LLM-generated SQL hits.
# Granting only SELECT means even a successfully-injected DROP TABLE fails.
DATABASE_READONLY_URL=postgresql://retail_readonly:retail_readonly@localhost:5432/olist

# ── Vector store ─────────────────────────────────────────────────────
# Local: Chroma in-process at this path.
# Prod: swap VECTOR_BACKEND=azure_ai_search and provide endpoint/key.
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=./.chroma

AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=retail-policies

# ── Blob (only used in prod) ─────────────────────────────────────────
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=policies

# ── Cost ceilings (enforced in FastAPI middleware) ───────────────────
# Without these, an infinite loop on a Friday night = a Monday-morning
# invoice you can't explain. Defend this in interviews.
MAX_TOKENS_PER_QUERY=8000
MAX_QUERIES_PER_DAY=500
DAILY_BUDGET_USD=5.00

# ── Observability ────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DB_PATH=./.logs/calls.sqlite

# ── Tenancy (RBAC scaffolding — real in prod, mock in dev) ───────────
DEFAULT_TENANT_ID=demo-tenant
